<script>
    document.addEventListener("DOMContentLoaded", function () {
        var designElement = document.getElementById("design");
        var desktopNav = document.getElementById("bottom-sticky-nav-desktop");
        var mobileNav = document.getElementById("bottom-sticky-nav-mobile");
        var hasBeenVisible = false; // Flag to track visibility state

        function updateNavVisibility(isVisible) {
            if (isVisible) hasBeenVisible = true; // Set the flag once it becomes visible

            // Apply styles only if the navbar has not been visible or is currently visible
            const opacity = isVisible || hasBeenVisible ? "1" : "0";
            const transform =
                isVisible || hasBeenVisible
                    ? "translateY(0)"
                    : "translateY(100px)";
            desktopNav.style.opacity = opacity;
            mobileNav.style.opacity = opacity;
            desktopNav.style.transform = transform;
            mobileNav.style.transform = transform;

            checkAndSetVisibility();
        }

        function checkAndSetVisibility() {
            if (window.innerWidth > 768) {
                desktopNav.style.visibility = "visible";
                mobileNav.style.visibility = "hidden";
            } else {
                desktopNav.style.visibility = "hidden";
                mobileNav.style.visibility = "visible";
            }
        }

        var observer = new IntersectionObserver(
            function (entries) {
                updateNavVisibility(entries[0].isIntersecting);
            },
            { threshold: 0.5 },
        );

        observer.observe(designElement);
        window.addEventListener("resize", checkAndSetVisibility);
        checkAndSetVisibility(); // Call it initially to set the correct visibility
    });
</script>

<div id="bottom-sticky-nav-desktop">
    <div class="bottom-stickiy-nav-wrapper hidden md:flex justify-center">
        <div
