    </div>
</div>
<div id="bottom-sticky-nav-mobile">
    <div class="bottom-stickiy-nav-wrapper flex justify-center md:hidden">
        <div class="w-full bottom-stickiy-nav-inner">
            <div
                class="flex items-center justify-center py-2 bg-contain bg-center bg-no-repeat [background-size:100%_100%] pb-10 pt-5"
                style="background-image:url('images/sticky-nav-bottom-mobile-solid.png');"
            >
                <a href="#top" class="flex text-sm items-center pt-2 plausible-event-name=Mobile+Nav+Click">
                    Discover the Mazda Interactive Showroom
                    <img
                        class="ml-3 h-3 w-auto invert"
                        src="images/icon-up-chevron.svg"
                        alt="icon-up-chevron"
                    />
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .bottom-stickiy-nav-wrapper {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        width: 100vw;
        overflow: hidden;
    }
    #bottom-sticky-nav-desktop,
    #bottom-sticky-nav-mobile {
        visibility: hidden;
        opacity: 0;
        transform: translateY(100px);
        transition:
            opacity 0.4s ease-in-out,
            transform 0.4s ease-in-out;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1000;
    }

    #bottom-sticky-nav-desktop .bottom-stickiy-nav-inner {
        width: 1517px;
        height: 68px;
    }

    #bottom-sticky-nav-mobile .bottom-stickiy-nav-inner {
        width: 100%;
        height: 70px;
    }
</style>
