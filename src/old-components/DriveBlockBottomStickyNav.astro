                    >
                        Design
                    </a>
                    <a
                        href="#interior"
                        class="text-center pr-4 xl:pr-10 my-2 mr-4 xl:mr-10 border-r border-[#cb8337] leading-5 plausible-event-name=Nav+Click"
                    >
                        Interior
                    </a>
                    <a
                        href="#features"
                        class="text-center pr-4 xl:pr-10 my-2 mr-4 xl:mr-10 border-r border-[#cb8337] leading-5 plausible-event-name=Nav+Click"
