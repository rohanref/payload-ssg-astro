---
const { id, open } = Astro.props;
---

<style>
    dialog {
        padding: 40px;
        color: white;
        background: black;
        border-radius: 20px;
    }
    dialog::backdrop {
        position: fixed;
        top: 0px;
        right: 0px;
        bottom: 0px;
        left: 0px;
        background: rgba(0, 0, 0, 0.5);
    }
    @media (orientation: landscape) {
        dialog {
            width: 90vw;
            height: 90vh;
            padding: 0;
        }
    }
</style>

<img
    class="md:hidden block"
    src="images/mazda-interactive-showroom-poster.webp"
    onclick={`window.${id}.showModal()`}
/>

<dialog id={id}>
    <form method="dialog">
        <slot name="close" />
    </form>
    <slot name="main" />
</dialog>
