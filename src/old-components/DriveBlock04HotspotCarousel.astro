---

---

<link rel="stylesheet" href="https://unpkg.com/flickity@2/dist/flickity.min.css">
<script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js"></script>

<div class="w-full">

    <div class="drive-hotspot-carousel bg-[#f0dac3] plausible-event-name=Carousel+Click">

        <div
            class="h-[18rem] lg:h-[28rem] drive-hotspot-carousel-slides flex flex-row"
            data-flickity='{ "cellAlign": "left", "contain": true, "autoPlay": 5000, "pauseAutoPlayOnHover": false, "groupCells": 2, "wrapAround": true}'
        >
            <div style="background-image: url('images/carousel/2024MazdaCX-6015.webp');"></div>
            <div style="background-image: url('images/carousel/2024MazdaCX-6029.webp');"></div>
            <div style="background-image: url('images/carousel/2024MazdaCX-6032.webp');"></div>
            <div style="background-image: url('images/carousel/2024MazdaCX-6023.webp');"></div>
            <div style="background-image: url('images/carousel/2024MazdaCX-6020.webp');"></div>
            <div style="background-image: url('images/carousel/2024MazdaCX-6025.webp');"></div>
            <div style="background-image: url('images/carousel/2024MazdaCX-9016.webp');"></div>
            <div style="background-image: url('images/carousel/2024MazdaCX-9021.webp');"></div>
            <div style="background-image: url('images/carousel/2024MazdaCX-9022.webp');"></div>
            <div style="background-image: url('images/carousel/2024MazdaCX-9028.webp');"></div>
            <div style="background-image: url('images/carousel/2024MazdaCX-9029.webp');"></div>
            <div style="background-image: url('images/carousel/2024MazdaCX-9054-3.webp');"></div>

        </div>

        <div class="pt-[4rem] pb-[7rem] px-[8.4%]">
            <div class="text-[#cb8337] text-[1.4rem] lg:text-[1.6rem] leading-[2rem] font-normal">Swipe across to explore the Mazda CX-60 and CX-90 interior</div>
        </div>

    </div>

</div>

<style>

.drive-hotspot-carousel-slides div {
    width: 33.3333333%;
    height: 28rem;
    background-size: cover;
    background-position:center;
} 


@media (min-width: 1024px) {

    .drive-hotspot-carousel-slides, .drive-hotspot-carousel-slides div { 
        height: 20rem;
    }

}
@media (max-width: 767px) { 
    .drive-hotspot-carousel-slides {
        height: 20rem;
    }
    .drive-hotspot-carousel-slides div { 
        width: 100%; height: 20rem;
    } 
}
@media (min-width: 1400px) {

    .drive-hotspot-carousel-slides, .drive-hotspot-carousel-slides div { 
        height: 32rem;
    }

}
@media (min-width: 1800px) {

    .drive-hotspot-carousel-slides, .drive-hotspot-carousel-slides div { 
        height: 40rem;
    }

}
</style>
