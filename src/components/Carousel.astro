---
interface Props {
  images: string[];
  caption: string;
  textColor?: string;
  barColor?: string;
  barColorBackground?: string;
  backgroundColor?: string;
  tracking?: string;
  grouping?: number;
}

const {
  images,
  caption,
  textColor = "#cb8337",
  barColor = "#cb8337",
  barColorBackground = "#fff",
  backgroundColor = "#f0dac3",
  grouping = 2,
  tracking,
}: Props = Astro.props;

import { plausibleClass } from "../helpers";

const carouselSpacing = `${100 / grouping}%`;
const dotSpacing = `${100 / Math.ceil(images.length / grouping)}%`;

const randomId = Math.random().toString(36).substring(7);
---

<div class="w-full">
  <div
    class={`drive-hotspot-carousel ${plausibleClass(tracking)}`}
    style={`background-color: ${backgroundColor};`}
  >
    <div
      id=`carousel-${randomId}`
      class="h-[18rem] lg:h-[28rem] drive-hotspot-carousel-slides flex flex-row"
      data-flickity={`{ "cellAlign": "left", "contain": true, "autoPlay": 5000, "pauseAutoPlayOnHover": false, "groupCells": ${grouping} , "wrapAround": true}`}
    >
      {
        images &&
          images.map((image) => (
            <div style={`background-image: url('${image}');`} />
          ))
      }
    </div>

    <div
      class="pt-4 pb-8 md:pt-8 md:pb-16 px-[8.4%]"
    >
      <div
        class="mx:text-[1.4rem] lg:text-[1.6rem] leading-[2rem] font-normal mb-4"
        style={`color: ${textColor}`}
      >
        {caption}
      </div>
      <div id=`dots-${randomId}` class="md:mt-10"></div>
    </div>
  </div>
</div>

<script define:vars={{ grouping, images, randomId }}>
  // Change flickity groupCells to true on sizes less than 768px else use the grouping value
  const flickity = document.querySelector(
      `#carousel-${randomId}`
    );
  let dotWidth = "";
  const options = JSON.parse(flickity.getAttribute("data-flickity"));
  const setGroupCells = () => {
    if (window.innerWidth < 768) {
      options.groupCells = true;
      flickity.setAttribute("data-flickity", JSON.stringify(options));
      // update css root variable for dot spacing
      dotWidth = `${100 / Math.ceil(images.length)}%`;
      console.log(dotWidth);
      flickity.style.cssText += `--dotSpacing: ${dotWidth}`;
    } else {
      options.groupCells = grouping;
      flickity.setAttribute("data-flickity", JSON.stringify(options));
    }
  };

  setGroupCells();
  function moveDots(params) {
  const carouselDots = document.querySelector(`#carousel-${randomId} .flickity-page-dots`);
  
  if (carouselDots) {
    const dots = document.getElementById(`dots-${randomId}`);
    if (dots) {
      dots.appendChild(carouselDots);
      // Set width on each child of carouselDots
      const children = carouselDots.children;  // Get all the child elements of .flickity-page-dots
      for (let child of children) {
        child.style.width = dotWidth; // Set the width of each child (or use any dynamic value here)
      }
    }
  } else {
    setTimeout(moveDots, 100);  // Retry if .flickity-page-dots is not found
  }
}

  moveDots();
</script>

<style define:vars={{ carouselSpacing }}>
  .drive-hotspot-carousel-slides div {
    width: var(--carouselSpacing);
    height: 28rem;
    background-size: cover;
    background-position: center;
  }
  @media (min-width: 1024px) {
    .drive-hotspot-carousel-slides,
    .drive-hotspot-carousel-slides div {
      height: 20rem;
    }
  }
  @media (max-width: 767px) {
    .drive-hotspot-carousel-slides {
      height: 20rem;
    }
    .drive-hotspot-carousel-slides div {
      width: 100%;
      height: 20rem;
    }
  }
  @media (min-width: 1400px) {
    .drive-hotspot-carousel-slides,
    .drive-hotspot-carousel-slides div {
      height: 32rem;
    }
  }
  @media (min-width: 1800px) {
    .drive-hotspot-carousel-slides,
    .drive-hotspot-carousel-slides div {
      height: 40rem;
    }
  }
</style>

<style define:vars={{ barColor, barColorBackground, dotSpacing }} is:global>
  .flickity-enabled {
    position: relative;
  }
  .flickity-enabled:focus {
    outline: 0;
  }
  .flickity-viewport {
    overflow: hidden;
    position: relative;
    height: 100%;
  }
  .flickity-slider {
    position: absolute;
    width: 100%;
    height: 100%;
  }
  .flickity-enabled.is-draggable {
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
  }
  .flickity-enabled.is-draggable .flickity-viewport {
    cursor: move;
    cursor: -webkit-grab;
    cursor: grab;
  }
  .flickity-enabled.is-draggable .flickity-viewport.is-pointer-down {
    cursor: -webkit-grabbing;
    cursor: grabbing;
  }
  .flickity-button {
    position: absolute;
    background: hsla(0, 0%, 100%, 0.75);
    border: none;
    color: #333;
  }
  .flickity-button:hover {
    background: #fff;
    cursor: pointer;
  }
  .flickity-button:focus {
    outline: 0;
    box-shadow: 0 0 0 5px #19f;
  }
  .flickity-button:active {
    opacity: 0.6;
  }
  .flickity-button:disabled {
    opacity: 0.3;
    cursor: auto;
    pointer-events: none;
  }
  .flickity-button-icon {
    fill: currentColor;
  }
  .flickity-prev-next-button {
    top: 50%;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    transform: translateY(-50%);
  }
  .flickity-prev-next-button.previous {
    left: 10px;
  }
  .flickity-prev-next-button.next {
    right: 10px;
  }
  .flickity-rtl .flickity-prev-next-button.previous {
    left: auto;
    right: 10px;
  }
  .flickity-rtl .flickity-prev-next-button.next {
    right: auto;
    left: 10px;
  }
  .flickity-prev-next-button .flickity-button-icon {
    position: absolute;
    left: 20%;
    top: 20%;
    width: 60%;
    height: 60%;
  }
  .flickity-page-dots {
    width: 100%;
    padding: 0;
    margin: 0;
    list-style: none;
    text-align: center;
    line-height: 1;
    position: relative;
  }
  .flickity-rtl .flickity-page-dots {
    direction: rtl;
  }
  .flickity-page-dots .dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin: 0 8px;
    background: #333;
    border-radius: 50%;
    opacity: 0.25;
    cursor: pointer;
  }
  .flickity-page-dots .dot.is-selected {
    opacity: 1;
  }

  .flickity-viewport {
    width: 100%;
  }
  .flickity-page-dots {
    background-color: var(--barColorBackground);
    height: 3px !important;
    text-align: left !important;
    bottom: 0;
  }
  .flickity-page-dots .dot {
    width: var(--dotSpacing);
    height: 3px !important;
    background: var(--barColorBackground) !important;
    border-radius: 0 !important;
    margin: 0 !important;
    opacity: 0;
    cursor: pointer;
    position: relative;
    top: -14px;
    transition: all 0.6s;
  }
  .flickity-page-dots .dot.is-selected {
    background: var(--barColor) !important;
    opacity: 1 !important;
  }
</style>