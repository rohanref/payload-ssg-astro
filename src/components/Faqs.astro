
---
interface FaqsItem {
  question: string;
  answerHTML: string;
}

interface Props {
  heading: string;
  questions: FaqsItem[];
}

const { heading, questions } = Astro.props;
---

<section class="px-5 py-16">
  <div class="mx-auto w-full max-w-[1300px]">
    <!-- Heading -->
    <h2 class="mb-10 text-center text-3xl font-bold md:text-4xl">
      {heading}
    </h2>

    <!-- FAQ Accordion -->
    <div class="flex flex-col gap-3">
      {questions.map((item) => (
        <details
          class="group rounded-lg bg-gray-100 transition-colors duration-200 open:bg-gray-200"
        >
          <!-- Question -->
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-lg p-5 font-semibold text-gray-900 [&::-webkit-details-marker]:hidden">
            <span class="text-lg">
              {item.question}
            </span>

            <!-- Arrow -->
            <svg
              class="h-5 w-5 shrink-0 text-gray-700 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>

          <!-- Answer -->
          <div class="px-5 pb-6 pt-1 text-gray-700">
            <div
              class="max-w-5xl"
              set:html={item.answerHTML}
            />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
