---
--- 

<section class="horizontal-wrapper">
    <div class="camera">
  <div class="horizontal-scroll">
    <div class="item" style="background: #f28b82;">Item 1</div>
    <div class="item" style="background: #fbbc04;">Item 2</div>
    <div class="item" style="background: #34a853;">Item 3</div>
    <div class="item" style="background: #4285f4;">Item 4</div>
  </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const wrapper = document.querySelector(".horizontal-wrapper");
    const scrollContainer = document.querySelector(".horizontal-scroll");

    const totalScrollWidth = scrollContainer.scrollWidth;
    const viewportHeight = window.innerHeight;

    // Set wrapper height to enable vertical scrolling enough for full horizontal scroll
    // scrollHeight = width of horizontal content - viewport width + viewport height
    const scrollHeight = totalScrollWidth - window.innerWidth + viewportHeight + viewportHeight;
    wrapper.style.height = `${scrollHeight}px`;

    window.addEventListener("scroll", () => {
      const scrollTop = window.scrollY;
      const wrapperOffsetTop = wrapper.offsetTop;

      const distanceScrolled = scrollTop - wrapperOffsetTop;
      const maxTranslateX = totalScrollWidth - window.innerWidth;

      if (scrollTop >= wrapperOffsetTop && scrollTop <= wrapperOffsetTop + scrollHeight) {
        const translateX = Math.min(Math.max(distanceScrolled, 0), maxTranslateX);
        scrollContainer.style.transform = `translateX(-${translateX}px)`;
      }
    });
  });
</script>

<style>
  .horizontal-wrapper {
    position: relative;
    /* overflow: hidden; <-- keep removed so sticky works */
    height: 300vh; /* will be overwritten by JS */
  }
  .camera {
    position: sticky;
    top: 0;
    left: 0;
    height: 100vh;
    overflow:hidden;
  }

  .horizontal-scroll {
    height: 100vh;
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .item {
    min-width: 100vw;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 2rem;
    user-select: none;
  }
</style>
