---
interface Props {
  title: string;
  articles: Article[];
}

interface Article {
  title: string;
  image: string;
  imageAlt: string;
  link: string;
  tracking?: string;
}

const { title, articles }: Props = Astro.props;

import { plausibleClass } from "../helpers";
---

<div class="px-[10%] pt-10 pb-28 bg-white text-black">
  <h2
    class="text-4xl md:text-5xl font-light text-center md:text-left py-10 md:py-16 md:px-10"
  >
    {title}
  </h2>
  <div class="flex md:flex-row flex-col gap-4 md:gap-[60px]">
    {
      articles.map((article) => (
        <div class="w-full md:w-1/3 border-2 border-gray-150">
          <a
            href={article.link}
            target="_blank"
            rel="nofollow"
            class={plausibleClass(article.tracking)}
          >
            <img class="w-full" src={article.image} alt={article.imageAlt} />
            <div class="flex items-center justify-between p-5 h-max">
              <span class="max-w-[90%]">{article.title}</span>
              <span class="">
                <img
                  class="w-4 h-[20px]"
                  src="images/ui/angle-right.svg"
                  alt="Go to article"
                />
              </span>
            </div>
          </a>
        </div>
      ))
    }
  </div>
</div>
