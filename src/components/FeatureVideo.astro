---
interface Props {
  video: string;
  thumbnail?: string;
  title?: string;
  textPosition?:
    | "top-left"
    | "top-center"
    | "top-right"
    | "center-left"
    | "center-center"
    | "center-right"
    | "bottom-left"
    | "bottom-center"
    | "bottom-right";
  style?: string;
  backgroundPosition?: string;
  parallax?: boolean;
  parallaxSpeed?: number;
}

const {
  video,
  thumbnail,
  title,
  style = "",
  textPosition,
  backgroundPosition = "center",
  parallax = false,
  parallaxSpeed = 0.5,
}: Props = Astro.props;

const position = (pos: string) => {
  switch (pos) {
    case "top-left":
      return "items-start justify-start";
    case "top-center":
      return "items-start justify-center";
    case "top-right":
      return "items-start justify-end";
    case "center-left":
      return "items-center justify-start";
    case "center-center":
      return "items-center justify-center";
    case "center-right":
      return "items-center justify-end";
    case "bottom-left":
      return "items-end justify-start";
    case "bottom-center":
      return "items-end justify-center";
    case "bottom-right":
      return "items-end justify-end";
    default:
      return "items-start justify-start";
  }
};

const randomId = Math.random().toString(36).substring(7);
---

<div class="h-[60vh] md:h-[100vh]">
  <video id={randomId} class="bg-video" autoplay loop muted poster={thumbnail}>
    <source src={video} type="video/mp4" />
  </video>
  {
    title && (
      <div
        class={`z-10 container mx-auto flex flex-col md:flex-row p-10 md:p-20 h-full ${position(textPosition)}`}
      >
        <h1 class={`text-white text-4xl font-bold ${style}`}>{title}</h1>
      </div>
    )
  }
</div>
{parallax && (
<script define:vars={{ randomId, parallax, parallaxSpeed }}>
  // parallax effect for randomId
  if (parallax) {
    const bgVideo = document.getElementById(randomId);
    window.addEventListener("scroll", () => {
      const videoTop = bgVideo.getBoundingClientRect().top;
      const videoHeight = bgVideo.getBoundingClientRect().height;
      const windowHeight = window.innerHeight;
      const position = videoTop + videoHeight;
      const visibility = (windowHeight - position) / videoHeight;
      bgVideo.style.transform = `translateY(${visibility * parallaxSpeed * 100}%)`;
    });
  }
</script>)}
<style>
  @media screen and (min-width: 768px) {
    .bg-video {
      height: 100vh !important;
    }
  }
  .bg-video {
    width: 100vw;
    height: 60vh;
    object-fit: cover;
    position: absolute;
    z-index: -1;
  }
</style>
