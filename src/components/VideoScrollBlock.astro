---
const { video, videoID } = Astro.props;
---

<style>
  .video-background {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    /*height: 100vh;
    object-fit: cover;*/
  }

  .video-container {
    position: relative;
    height: 100vh;
  }
</style>

<div class="video-container" id={`video-container-${videoID}`}>
  <video
    src={video}
    playsinline
    webkit-playsinline
    preload="auto"
    muted
    class="video-background"
    id={videoID}
  ></video>
</div>

<script type="module" define:vars={{videoID}}>
  import gsap from 'https://cdn.skypack.dev/gsap@3.12.5';
  import { ScrollTrigger } from 'https://cdn.skypack.dev/gsap@3.12.5/ScrollTrigger';

  window.addEventListener("DOMContentLoaded", () => {
    const video = document.querySelector(`#${videoID}`);
    if (!video) return;

    gsap.registerPlugin(ScrollTrigger);

    const tl = gsap.timeline({
        scrollTrigger: {
        trigger: `#video-container-${videoID}`,
        start: "top top",
        end: "+=100%",
        scrub: true,
        pin: true,
        markers: false
        }
    });

    const videoTime = { currentTime: 0 }; // plain object to tween
    console.log('videoTime', videoTime);

    tl.fromTo(
    videoTime,
    { currentTime: 0 },
    {
        currentTime: video.duration || 1,
        ease: "none",
        onUpdate: () => {
        video.currentTime = videoTime.currentTime;
        console.log('Current Time:', videoTime.currentTime);
        }
    }
    );
});

</script>

