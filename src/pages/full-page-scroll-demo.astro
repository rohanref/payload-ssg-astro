---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";

// New Components
import FullPageScroll from "../components/FullPageScroll.astro";

// - Update to deploy to Vercel
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Full Page Scroll Demo"
  description="The full page scroll block as seen no Jaguar F Type and VW Amarok"
  url={`https://brandedcontent.com.au${base}`}
  pngImage={`${base}images/og-image.png`}
  GTM="G-2HBF4HYLXD"
>
  <NavBar
    homeLink="#"
    link="/"
    linkText="Main Component Demo"
  />
  <main class="overflow-hidden">
    <FullPageScroll
      sections={[
        {
          title: "Section 1",
          quote:
            "Subtitle",
          content:
            "Content in here",
          position: "justify-center sm:!pb-[100px]",
          backgroundContent:
            "md:bg-[url(/images/page/hellcat.jpg)] bg-[url(/images/page/hellcat.jpg)]",
        },
        {
          title: "Section 2",
          quote:
            "Subtitle",
          content:
            "Content in here",
          position: "justify-center sm:!pb-[100px]",
          backgroundContent:
            "md:bg-[url(/images/page/lambo.jpg)] bg-[url(/images/page/lambo.jpg)]",
        },
        {
          title: "Section 3",
          quote:
            "Subtitle",
          content:
            "Content in here",
          position: "justify-center sm:!pb-[100px]",
          backgroundContent:
            "md:bg-[url(/images/page/hellcat.jpg)] bg-[url(/images/page/hellcat.jpg)]",
        },
      ]}
    >

      <div class="section flex items-center justify-center" slot="header">
        <h2 class="md:text-4xl text-3xl py-2 font-bold text-white">
          HEADER SLOT HERE
        </h2>
      </div>
    </FullPageScroll>
  </main>
</Layout>